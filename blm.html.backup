      <style>
        .bird-content {
          font-family: 'Georgia', serif;
          background: linear-gradient(180deg, #f0f9ff 0%, #e0f2fe 100%);
          padding: 60px 20px;
        }
        .bird-hero {
          text-align: center;
          margin-bottom: 50px;
        }
        .bird-hero h1 {
          font-size: 56px;
          color: #0c4a6e;
          margin-bottom: 15px;
          font-weight: bold;
          text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }
        .bird-hero p {
          font-size: 22px;
          color: #0369a1;
          font-style: italic;
        }
        .bird-grid {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
          gap: 25px;
          max-width: 1400px;
          margin: 0 auto 50px;
        }
        .bird-card {
          background: white;
          border-radius: 16px;
          overflow: hidden;
          box-shadow: 0 8px 24px rgba(0,0,0,0.12);
          transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .bird-card:hover {
          transform: translateY(-8px);
          box-shadow: 0 12px 32px rgba(0,0,0,0.18);
        }
        .bird-card-header {
          height: 180px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 100px;
          position: relative;
        }
        .bird-card-header::after {
          content: '';
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          height: 3px;
          background: rgba(255,255,255,0.3);
        }
        .bird-card-body {
          padding: 25px;
        }
        .bird-name {
          font-size: 26px;
          color: #1e293b;
          margin-bottom: 8px;
          font-weight: bold;
        }
        .bird-scientific {
          font-size: 16px;
          color: #64748b;
          font-style: italic;
          margin-bottom: 18px;
        }
        .bird-description {
          font-size: 15px;
          color: #475569;
          line-height: 1.7;
          margin-bottom: 20px;
        }
        .bird-stats {
          display: flex;
          justify-content: space-around;
          padding-top: 15px;
          border-top: 2px dashed #e2e8f0;
        }
        .bird-stat {
          text-align: center;
        }
        .bird-stat-label {
          font-size: 11px;
          color: #94a3b8;
          text-transform: uppercase;
          letter-spacing: 0.5px;
          margin-bottom: 5px;
        }
        .bird-stat-value {
          font-size: 16px;
          color: #0f172a;
          font-weight: bold;
        }
        .fun-facts {
          max-width: 1000px;
          margin: 60px auto;
          background: white;
          border-radius: 20px;
          padding: 40px;
          box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        .fun-facts h2 {
          font-size: 38px;
          color: #0c4a6e;
          text-align: center;
          margin-bottom: 30px;
        }
        .fact-item {
          display: flex;
          align-items: start;
          margin-bottom: 20px;
          padding: 15px;
          background: #f1f5f9;
          border-radius: 12px;
        }
        .fact-emoji {
          font-size: 32px;
          margin-right: 15px;
        }
        .fact-text {
          font-size: 17px;
          color: #334155;
          line-height: 1.6;
        }
      </style>
      
