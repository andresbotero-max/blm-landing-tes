<script>
(function() {
  document.addEventListener('click', function(event) {
    const trigger = event.target.closest('[data-action="toggle-find-in-store"]');
    if (trigger) {
      event.preventDefault();
      
      const drawer = document.querySelector('.find-in-store-drawer__drawer');
      if (drawer) {
        if (drawer.open) {
          drawer.hide();
        } else {
          drawer.show();
        }
      }
    }
  });
})();
</script>


