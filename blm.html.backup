    .top-bar[data-section-id="sections--18748523937867__top-bar"] {
      background-color: #2f394b;
    }.announcement__slide--slide_1,
      .announcement__slide-fade--slide_1 {
        background: transparent;
        color: #ffffff;
      }.announcement__slide--slide_2,
